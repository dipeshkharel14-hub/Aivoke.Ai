# Copy to .env.local (never commit it). Only NEXT_PUBLIC_* values reach the browser.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://aivokeai.vercel.app
SUPPORT_EMAIL=info@khareldipesh.com.np
# Technical sender address for Resend (on your verified domain). Used only as the From header, never shown on the site.
RESEND_FROM_ADDRESS=
IP_HASH_SALT=replace-with-long-random-string
CRON_SECRET=replace-with-long-random-string

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER ONLY

# --- Gemini (server only) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=your-chat-model-name
GEMINI_EMBEDDING_MODEL=your-embedding-model-name
GEMINI_EMBEDDING_DIMENSIONS=768

# --- Quotas ---
GUEST_DAILY_QUESTIONS=3
MEMBER_DAILY_QUESTIONS=20

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Resend ---
RESEND_API_KEY=your-resend-api-key

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# --- Optional ---
GOOGLE_SAFE_BROWSING_API_KEY=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=aivokeai.vercel.app
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
